<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Show post by country</title>
</head>
<body>
     <%- include('../partials/navbar') %>
     
    <% for(let onePost of posts){ %>
        <h1>All posts for <%= onePost.country.countryName%></h1>
        <a href="/posts/<%= onePost._id  %>"><%= onePost.title%></a>
    <% } %>

</body>
</html>