<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Show post by country</title>
      <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Condensed:ital,wght@0,400..700;1,400..700&family=Smooch+Sans:wght@100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/navbar-style.css">
</head>
<body>
     <%- include('../partials/navbar') %>
     
    <% for(let onePost of posts){ %>
        <h1>All posts for <%= onePost.country.countryName%></h1>
        <a href="/posts/<%= onePost._id  %>"><%= onePost.title%></a>
    <% } %>

</body>
</html>