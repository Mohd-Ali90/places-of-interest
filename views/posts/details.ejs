<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Post Details</title>
      <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Condensed:ital,wght@0,400..700;1,400..700&family=Smooch+Sans:wght@100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/navbar-style.css">
</head>

<body>
    <%- include('../partials/navbar') %>
        <h1>Post Details</h1>

        <p> Title: <%= post.title %></p>
        <img src="<%= post.image  %>" alt="Post-related image">
        <p>Address: <%= post.address %></p>
        <p>What I think about this place: <%= post.postBody %></p>
         
        <p>I give this place a rating of <%= post.rating %> out of 5 </p>

        <p> What country is this in?: <%= post.country.countryName %></p>  
        
        <% if(post.owner._id.equals(user._id)){ %>
            <form action="/posts/<%= post._id %>?_method=DELETE" method="post">
                <button>Delete Post</button>
            </form>

            <form action="/posts/<%= post._id%>/edit" method="get">
                    <button>Edit Post</button>
                </form>
            <% } %>
</body>

</html>