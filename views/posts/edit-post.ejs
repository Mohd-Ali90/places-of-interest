<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit post</title>
</head>
<body>
    <h1>Edit your post here</h1>

     <form action="/posts" method="post">
        <label for="title">Post Title:</label>
        <input value="<%= post.title%>" id="title" name="title" type="text">

        <label for="image">Enter the URL for the new image here</label>
        <input value="<%= post.image %>" id="image" name="image" type="text">

        <label for="address">Do you want to update the address?:</label>
        <input value="<%= post.address %>" id="address" name="address" type="text">

        <label for="postBody">Have you changed your thoughts on this place?</label>
        <input value="<%= post.postBody %>" id="postBody" name="postBody" type="text">

        <label for="rating">You rated <%= post.rating %>  , do you have a new rating in mind?</label>
        <input  id="rating" name="rating" type="number">

        <label for="countryName"> The country is <%= post.country.countryName %> Do you want to change the country?</label>
        <select name="countryName" id="countryName">
            <% for(oneCountry of country){ %>
                  <option value="<%= oneCountry._id %>"><%= oneCountry.countryName %></option>
            <% } %>
        </select>

        <button> Save Edit</button>
    </form>
</body>
</html>