<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit post</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Condensed:ital,wght@0,400..700;1,400..700&family=Smooch+Sans:wght@100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/navbar-style.css">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
  <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
        <link rel="stylesheet" href="/css/edit-post.css">
</head>
<body>
    <h2>Edit your post here</h2>

     <form action="/posts/<%=post._id %>?_method=PUT" method="post">
        <div class="form-group">
        <label for="title">Post Title:</label>
        <input value="<%= post.title%>" id="title" name="title" type="text">
         </div>

         <div class="form-group">
        <label for="image">Enter the URL for the new image here</label>
        <input value="<%= post.image %>" id="image" name="image" type="text">
         </div>

         <div class="form-group">
        <label for="address">Do you want to update the address?:</label>
        <input value="<%= post.address %>" id="address" name="address" type="text">
         </div>

         <div class="form-group">
        <label for="postBody">Have you changed your thoughts on this place?</label>
        <input value="<%= post.postBody %>" id="postBody" name="postBody" type="text">
         </div>

         <div class="form-group">
        <label for="rating">You rated <%= post.rating %>  , do you have a new rating in mind?</label>
        <input type="radio" id="star1" name="rating" value="1">
        <label for="star1">1</label>
         
        <input type="radio" id="star2" name="rating" value="2">
        <label for="star2">2</label>

        <input type="radio" id="star3" name="rating" value="3">
        <label for="star3">3</label>

        <input type="radio" id="star4" name="rating" value="4">
        <label for="star4">4</label>

        <input type="radio" id="star5" name="rating" value="5">
        <label for="star5">5</label>
        </div>
         
        <div class="form-group">
        <label for="countryName"> The country is <%= post.country.countryName %> Do you want to change the country?</label>
        <select name="countryName" id="countryName">
            <% for(oneCountry of country){ %>
                  <option value="<%= oneCountry._id %>"><%= oneCountry.countryName %></option>
            <% } %>
        </select>
         </div>
        <button class="btn btn-default"> Save Edit</button>
    </form>
</body>
</html>