<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All posts page</title>
      <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Condensed:ital,wght@0,400..700;1,400..700&family=Smooch+Sans:wght@100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/navbar-style.css">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
  <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
        <link rel="stylesheet" href="/css/all-posts.css">
</head>


<body>
    <%- include('../partials/navbar') %>
    <h2>All posts page</h2>
    <div class="form-group">
        
          <% for(let onePost of posts) { %>
            <div class="tile">
          <p> <%= onePost.title  %> by <%= onePost.owner.username %> </p>
          <a href="/posts/<%= onePost._id  %>">See details of this post</a>
          </div>
           <% } %>
    
    </div>
</body>
</html>