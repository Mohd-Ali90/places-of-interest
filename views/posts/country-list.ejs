<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Country List</title>
      <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Condensed:ital,wght@0,400..700;1,400..700&family=Smooch+Sans:wght@100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/navbar-style.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    <h1>All countries with posts</h1>

    <% for(let onePost of posts){ %>
        <a href="/posts/by-country/<%= onePost.country._id %>"> <%= onePost.country.countryName %></a>
    <% } %>
</body>
</html>