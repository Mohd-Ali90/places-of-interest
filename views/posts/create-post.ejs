<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New Post</title>
      <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Condensed:ital,wght@0,400..700;1,400..700&family=Smooch+Sans:wght@100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/navbar-style.css">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
  <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
        <link rel="stylesheet" href="/css/create-post.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    <h2>Create New Post</h2>

    <form action="/posts" method="post">
        <div class="form-group">
        <label for="title">Post Title:</label>
        <input id="title" name="title" type="text">
        </div>

        <div class="form-group">
             <label for="image">URL for your image:</label>
             <input id="image" name="image" type="text">
            
        </div>
         
        <div class="form-group">
        <label for="address">What is the address of this location?:</label>
        <input id="address" name="address" type="text">
         </div>

         <div class="form-group">
        <label for="postBody">What are your thoughts on this place?</label>
        <input id="postBody" name="postBody" type="text">
         </div>

         <div class="form-group">
        <label for="rating">From 1(lowest) to 5(highest) , How would you rate this place?</label>
        <input type="radio" id="star1" name="rating" value="1">
        <label for="star1">1</label>

        <input type="radio" id="star2" name="rating" value="2">
        <label for="star2">2</label>

        <input type="radio" id="star3" name="rating" value="3">
        <label for="star3">3</label>

        <input type="radio" id="star4" name="rating" value="4">
        <label for="star4">4</label>

        <input type="radio" id="star5" name="rating" value="5">
        <label for="star5">5</label>
        </div>

        <div class="form-group">
        <label for="countryName">What country is this location in?</label>
        <select name="countryName" id="countryName">
            <% for(oneCountry of country){ %>
                  <option value="<%= oneCountry._id %>"><%= oneCountry.countryName %></option>
            <% } %>
        </select>
         </div>

        <button class="btn btn-default"> Create Post</button>
    </form>
</body>
</html>